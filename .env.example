# =============================================================================
# dfe-transform-vector Environment (example)
# =============================================================================
# Copy to .env and fill in real values.

# =============================================================================
# Test Mode Selection
# =============================================================================
# TEST_MODE controls which backends integration and e2e tests use:
#
#   "remote"  (default) — use the Kafka endpoint below
#   "docker"            — use dfe-docker infra profile (localhost:19092, no auth)
TEST_MODE="remote"

# =============================================================================
# Kafka
# =============================================================================
KAFKA_BROKERS="kafka.example.com:9092"
KAFKA_SASL_MECHANISM="SCRAM-SHA-512"
KAFKA_SECURITY_PROTOCOL="SASL_SSL"
KAFKA_SASL_USER="<service-user>"
KAFKA_SASL_PASSWORD="<password>"
