# =============================================================================
# dfe-transform-vector Environment (example)
# =============================================================================
# Copy to .env and fill in real values. Never commit the real .env.
#
# Test backend selection is automatic (live-first, testcontainers fallback):
#   1. If KAFKA_* vars below authenticate against a real cluster, tests use it
#      (faster + realistic cluster setup).
#   2. Otherwise tests spawn an ephemeral Apache Kafka container via Docker.
#   3. If Docker is also unavailable, tests skip gracefully.
#
# No TEST_MODE env var needed — fixture probes automatically.

# =============================================================================
# Kafka (live cluster — preferred)
# =============================================================================
# Credentials source: OpenBao kv/infrastructure/kafka (key: admin_password).
# See /projects/hyperi-infra/docs/DEVEX-KAFKA-CH-CONNECTIONS.md for details.
KAFKA_BROKERS="kafka.example.com:9092"
KAFKA_SASL_MECHANISM="SCRAM-SHA-512"
KAFKA_SECURITY_PROTOCOL="SASL_SSL"
KAFKA_SASL_USER="<service-user>"
KAFKA_SASL_PASSWORD="<password>"
# Set to "false" to enforce TLS verification (default: skip_verify=true for dev clusters).
# KAFKA_SSL_SKIP_VERIFY="true"
